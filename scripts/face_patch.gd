class_name FacePatch
extends Node2D
## A talking head for someone baked into a room's background (or an overlay): small cut-outs of their face rendered
## with the mouth half open, open and the eyes shut (tools/r3/render_room.py, `faces` in the set's meta), laid over the
## background. Generated by build_scenes.py under the y-sorted Actors, at the person's floor point, so the detective
## still walks in front of them. Main sets `mouth` from the voice level while their clip plays; they blink on their own.

const BLINK_GAP := Vector2(3.0, 6.0)    ## seconds between blinks (random in this range)
const BLINK_TIME := 0.13

@export var speaker := ""
@export var mouth_frames: Array[Texture2D] = []   ## half open, open
@export var mouth_pos := Vector2.ZERO             ## top-left of the mouth cut-out, room pixels
@export var eyes_frame: Texture2D
@export var eyes_pos := Vector2.ZERO
@export var follow := NodePath()                  ## an overlay sprite whose visibility this face follows (if any)

var mouth := 0:                                   ## 0 closed (the background), 1 half open, 2 open
	set(v):
		mouth = clampi(v, 0, mouth_frames.size())
		if _mouth:
			_mouth.visible = mouth > 0
			if mouth > 0:
				_mouth.texture = mouth_frames[mouth - 1]

var _mouth: Sprite2D
var _eyes: Sprite2D
var _next_blink := 0.0
var _blink_left := 0.0
var _follow: CanvasItem


func _ready() -> void:
	# children are placed in room pixels, so undo this node's position (the y-sort base)
	_mouth = _part(mouth_frames[0] if not mouth_frames.is_empty() else null, mouth_pos)
	_eyes = _part(eyes_frame, eyes_pos)
	_mouth.visible = false
	_eyes.visible = false
	_next_blink = randf_range(BLINK_GAP.x, BLINK_GAP.y)
	if not follow.is_empty():
		_follow = get_node_or_null(follow) as CanvasItem


func _part(tex: Texture2D, at: Vector2) -> Sprite2D:
	var s := Sprite2D.new()
	s.texture = tex
	s.centered = false
	s.position = at - position
	add_child(s)
	return s


func _process(delta: float) -> void:
	if _follow:
		visible = _follow.visible
	if eyes_frame == null:
		return
	if _blink_left > 0.0:
		_blink_left -= delta
		if _blink_left <= 0.0:
			_eyes.visible = false
			_next_blink = randf_range(BLINK_GAP.x, BLINK_GAP.y)
		return
	_next_blink -= delta
	if _next_blink <= 0.0:
		_eyes.visible = true
		_blink_left = BLINK_TIME
